# Persistent /var on the second Linode disk (tofu: state_disk_mb > 0 -> /dev/sdb).
# Ignition runs on every boot, so nothing here wipes an existing table/filesystem.
variant: fcos
version: 1.7.0
storage:
  disks:
    - device: /dev/sdb
      wipe_table: false
      partitions:
        - number: 1
          label: bluefin-var
          wipe_partition_entry: false
  filesystems:
    - device: /dev/disk/by-partlabel/bluefin-var
      format: xfs
      label: bluefin-var
      wipe_filesystem: false
systemd:
  units:
    - name: var.mount
      enabled: true
      contents: |
        [Unit]
        Description=Persistent /var on the Ignition-provisioned disk

        [Mount]
        What=/dev/disk/by-label/bluefin-var
        Where=/var
        Type=xfs
        Options=defaults

        [Install]
        WantedBy=local-fs.target
