# Copy to .env (git-ignored). Prefer exporting LINODE_TOKEN in your shell.
LINODE_TOKEN=""

# Linode placement. Region must match the uploaded image. `linode-cli regions list`
REGION="us-ord"
# Bluefin Server needs RAM for the OS and, for a diskless boot, the whole DDI.
INSTANCE_TYPE="g6-standard-2"
LABEL="bluefin"

# Identity, delivered via Ignition (Bluefin ships no password; sshd is off by preset).
SSH_AUTHORIZED_KEY=""
NODE_HOSTNAME="bluefin-akamai"

# Server release the boot disk is built from ("latest" or e.g. 26.11.2806).
BLUEFIN_VERSION="latest"
# Where the node pulls the OS image from (default: that release on GitHub).
# DDI_BASE_URL=""
# Optional: a cpio appended to the initrd (scripts/dev-initrd-overlay.sh).
# EXTRA_INITRD=""
# Filled in after `make image`, e.g. private/1234567
IMAGE_ID=""

# Butane overlay from butane/overlays/ (without .bu): state-disk formats the
# second disk as /var; server/home-server after `make overlays`.
OVERLAY="state-disk"

BUTANE_VERSION="v0.29.0"
